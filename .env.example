# PhishGuard configuration. Copy to backend/.env (local dev) or .env (docker compose).
# NEVER commit real values: .env files are git-ignored.

# --- General ---------------------------------------------------------------------------------
# development | test | production  (production refuses to start with the dev JWT secret or insecure cookies)
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------------------------
# Default (unset): zero-setup SQLite file at backend/phishguard.db
# PostgreSQL:      postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=postgresql+psycopg://phishguard:change-me@localhost:5432/phishguard
POSTGRES_PASSWORD=change-me-local-only

# --- Auth ------------------------------------------------------------------------------------
# REQUIRED in production: a random string of 32+ characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# true when served over HTTPS (required in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Web -------------------------------------------------------------------------------------
# Only this origin is allowed by CORS (the frontend normally proxies /api so CORS is rarely used)
FRONTEND_ORIGIN=http://localhost:3000
# Hard cap on request body size in bytes
MAX_REQUEST_BYTES=256000
# Frontend only: where Next.js proxies /api/v1/* (default http://127.0.0.1:8001)
BACKEND_URL=http://127.0.0.1:8001

# --- Rate limits (requests per minute per client IP) -----------------------------------------
RATE_LIMIT_AUTH=10
RATE_LIMIT_AI=30
RATE_LIMIT_REPORT=20

# --- AI --------------------------------------------------------------------------------------
# demo | openai | anthropic. If the matching key is empty, the app runs in labelled DEMO MODE.
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
AI_TIMEOUT_SECONDS=30
# auto | chroma | memory   (auto = ChromaDB if importable, else in-memory)
VECTOR_STORE=auto
# CHROMA_PATH=backend/.chroma

# --- Optional infrastructure -----------------------------------------------------------------
# Feature flag: Redis-backed cache/queue (documented design; in-process cache is used when unset)
REDIS_URL=
# Mock OIDC identity provider for SSO demos. Set false in production.
OIDC_MOCK_ENABLED=true
